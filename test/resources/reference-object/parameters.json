{
  "openapi": "3.1.0",
  "info": {
    "title": "Swagger Petstore - OpenAPI 3.1",
    "version": "1.0.12"
  },
  "paths": {
    "/path1": {
      "post": {
        "summary": "Finds Pets by status. (parameters)",
        "description": "Multiple status values can be provided with comma separated strings.",
        "operationId": "findPetsByStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/status",
            "description": "status parameter description override"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "status": {
        "name": "status",
        "in": "query",
        "description": "Status values that need to be considered for filter",
        "required": false,
        "explode": true,
        "schema": {
          "type": "string",
          "default": "available",
          "enum": [
            "available",
            "pending",
            "sold"
          ]
        }
      }
    }
  }
}