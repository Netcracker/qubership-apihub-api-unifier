                "$ref": "#/components/headers/X-Rate-Limit",
                "description": "header description override"
              },
              "X-Expires-After": {
                "description": "date in UTC when token expires",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "X-Rate-Limit": {
        "description": "(description from components) calls per hour allowed by the user",
        "schema": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  }
